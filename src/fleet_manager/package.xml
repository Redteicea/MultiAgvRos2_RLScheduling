<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema-instance"?>
<package format="3">
  <name>fleet_manager</name>
  <version>0.1.0</version>
  <description>多 AGV 仓储调度系统：任务分配、路径规划、路权管理、冲突消解与死锁检测</description>
  <maintainer email="howgreat@todo.todo">howgreat</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>gazebo_msgs</depend>
  <depend>std_srvs</depend>
  <depend>fleet_common</depend>
  <depend>teb_planner</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
